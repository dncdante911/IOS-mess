# ─── Зависимости ─────────────────────────────────────────────────────────────
#
# node_modules НИКОГДА не коммитим. Помимо размера есть причина посерьёзнее:
# Windows не хранит бит исполняемости, поэтому попавшие в репозиторий файлы
# node_modules/.bin/* приезжают на macOS-раннер без права на запуск, и сборка
# падает с "Permission denied" (exit code 126). Зависимости ставит `npm ci`
# из package-lock.json — он как раз коммитится.
node_modules/
.pnp
.pnp.js

# ─── Нативные проекты (генерируются) ─────────────────────────────────────────
#
# ios/ и android/ создаёт `npx expo prebuild` из app.json. Держать их в git
# нельзя: правки в app.json тогда молча не применяются, а конфликты в
# Xcode-проекте и Podfile.lock неразрешимы.
ios/
android/

# ─── Expo / Metro ────────────────────────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ─── Сборки ──────────────────────────────────────────────────────────────────
*.ipa
*.apk
*.aab
build/
Pods/

# ─── Секреты ─────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
google-services.json
GoogleService-Info.plist
*.p8
*.p12
*.mobileprovision
*.keystore

# ─── ОС и редакторы ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-error.log*
.idea/
.vscode/
*.swp
